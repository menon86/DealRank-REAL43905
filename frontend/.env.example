# Copy to frontend/.env.local and adjust if the backend runs somewhere
# other than the default (matches backend/.env.example's dev setup).
VITE_API_BASE_URL=http://localhost:8000

# Sign-in (leave blank for local dev with AUTH_REQUIRED=false on the API)
VITE_GOOGLE_CLIENT_ID=
VITE_MICROSOFT_CLIENT_ID=
VITE_MICROSOFT_TENANT_ID=
# Show the "Try the demo" button (needs DEMO_ENABLED on the API)
VITE_DEMO_ENABLED=
