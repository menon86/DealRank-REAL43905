# Copy to backend/.env and fill in real values. Never commit backend/.env.

# PostgreSQL connection string used by SQLAlchemy/Alembic.
# Matches the service defined in docker-compose.yml for local dev.
DATABASE_URL=postgresql+psycopg://dealrank:dealrank@localhost:5432/dealrank

# FastAPI / app config
APP_ENV=development
APP_NAME=DealRank
LOG_LEVEL=info

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Optional: used when both live lookups (FRED, then US Treasury) fail
# TREASURY_10Y_FALLBACK=0.046

# --- Chat assistant (read-only, tool-grounded; see app/api/chat.py) ---
# Any OpenAI-compatible endpoint. Default: Google Gemini free tier.
# Leave LLM_API_KEY blank and /chat returns 503 (the UI falls back to preset answers).
# Never commit a real key — set it only in backend/.env or the host's environment.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
# Cap on tokens generated per model call
LLM_MAX_TOKENS=1024
# Per-IP requests per minute to /chat (in-memory, per process)
CHAT_RATE_LIMIT_PER_MIN=10

# Alternatives (swap in place of the three LLM_* lines above):
# Groq:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# OpenRouter (free models end in :free):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Local Ollama (the key is ignored by Ollama but must be non-empty):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=ollama
